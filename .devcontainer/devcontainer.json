{
  "name": "SAJI Mobile Video Effects Studio",
  "build": {
    "dockerfile": "../mobile-studio/Dockerfile",
    "context": "../mobile-studio"
  },
  "forwardPorts": [
    7860
  ],
  "portsAttributes": {
    "7860": {
      "label": "SAJI Video Studio",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip"
}
